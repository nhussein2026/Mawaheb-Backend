# ------------------------------------------------------------------
# Mawaheb API — environment variables
# Copy this file to `.env` and fill in the values before running.
#   cp .env.example .env
# ------------------------------------------------------------------

# --- Server ---
# Port the API listens on locally (code falls back to 3005 if unset).
PORT=3000
# Set to "production" to disable the local app.listen() (used by Azure).
NODE_ENV=development

# --- Database (required) ---
# Local MongoDB, or a MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/mawaheb-api

# --- Auth / JWT (required) ---
# Secret used to sign & verify JWTs. Use a long random string.
ACCESS_TOKEN_SECRET=change-me-to-a-long-random-secret
# Token lifetime, e.g. 1h, 7d, 30d.
JWT_EXPIRES_IN=7d

# --- Initial admin bootstrap ---
# On startup an Admin user is created (or an existing user promoted) from these.
# Both must be set or the bootstrap is skipped entirely.
INITIAL_ADMIN_EMAIL=admin@mawaheb.com
INITIAL_ADMIN_PASSWORD=change-me-before-first-boot
INITIAL_ADMIN_NAME=Super Admin

# --- Seeding ---
# Academic years (2025/2026, 2026/2027) are auto-seeded on boot outside
# production. Set to "true" to opt a production deploy into that too.
SEED_ACADEMIC_YEARS=false
# `npm run seed` refuses to touch a non-local database unless this names the
# target database exactly. It has no effect when NODE_ENV=production, where the
# demo seed is blocked outright.
# SEED_CONFIRM=

# --- Cloudinary (file/image uploads) ---
# Required for certificate / upload endpoints. Get these from your Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Nodemailer, e.g. password reset) ---
# Gmail address and a Google "App Password" (not your normal password).
EMAIL=
PASSWORD_APP_EMAIL=
